{
  "name": "git-prasaaran-documentation-agent",
  "version": "1.0.0",
  "description": "Human-supervised agent definition for Git-Prasaaran documentation tasks.",
  "entrypoint": "AGENT.md",
  "capabilities_manifest": "../../agent-capabilities/capabilities.json",
  "mcp_server": "../../mcp-server",
  "permissions": {
    "published_document_access": "read-only",
    "draft_output": "allowed",
    "local_markdown_validation": "explicit-files-only",
    "arbitrary_filesystem_access": "not-granted",
    "shell_execution": "not-granted",
    "git_writes": "not-granted",
    "production_publishing": "not-granted"
  },
  "human_review_required": true
}
