# Copy this file to .env and replace the placeholder values for local development.
POSTGRES_PASSWORD=replace-with-a-strong-local-password
JWT_SECRET=replace-with-strong-local-secret
GITHUB_OWNER=your-github-owner
GITHUB_REPOSITORY=your-documentation-repository
GITHUB_BRANCH=main
GITHUB_CONTENT_PATH=docs
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-local-password
VITE_API_BASE_URL=http://localhost:8080
ALERT_WEBHOOK_SECRET=replace-with-a-strong-local-webhook-secret
